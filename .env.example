# Porta e interface de escuta
PORT=3000
HOST=0.0.0.0

# URL pública do site (usada no sitemap, robots.txt e na verificação de origem do formulário)
SITE_URL=https://www.seudominio.com.br

# Defina como 1 somente se o app estiver atrás de um proxy reverso confiável (Nginx, Cloudflare, Render...)
TRUST_PROXY=0

# Pasta onde os leads são gravados (arquivo leads.jsonl, permissão 600)
DATA_DIR=./data

# Opcional: webhook HTTPS para receber cada lead (Zapier, Make, n8n, CRM...)
LEAD_WEBHOOK_URL=

# Número de WhatsApp da clínica (somente dígitos, com DDI)
WHATSAPP_NUMBER=5548988365189
